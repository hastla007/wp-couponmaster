<?xml version="1.0"?>
<ruleset name="Voucher Captain">
	<description>
		Wide coding-standards scan of the whole plugin: WordPress-Extra, WordPress.WP.I18n (text domain voucher-captain)
		and WordPress.Security.*. Runs in the CI job quality-wide (report-only until the findings are worked off, see
		RELEASE.md → Static analysis). The strict scan of src/API/V1 and src/Contracts in the job quality stays blocking.
	</description>

	<file>voucher-captain.php</file>
	<file>uninstall.php</file>
	<file>config</file>
	<file>src</file>
	<file>templates</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress-Extra">
		<!-- Classes follow PSR-4 (src/Foo/BarBaz.php), not class-bar-baz.php. Permanent decision, no debt. -->
		<exclude name="WordPress.Files.FileName"/>
		<!--
			Technical debt (RELEASE.md → Static analysis): formatting rules the code base does not follow yet. They are
			cosmetic and would hide the findings that matter (security, i18n, deprecated APIs). Remove one exclusion at
			a time together with the clean-up commit.
		-->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="Generic.Formatting.MultipleStatementAlignment"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Operators.StrictComparisons"/>
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Commenting"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
		<exclude name="Squiz.PHP.EmbeddedPhp"/>
		<exclude name="PSR2.Methods.FunctionClosingBrace"/>
	</rule>

	<!-- Every translatable text uses the plugin's own text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="voucher-captain"/>
			</property>
		</properties>
	</rule>

	<!-- Escaping, nonces, sanitising and safe redirects (part of WordPress-Extra; listed so it can never be excluded). -->
	<rule ref="WordPress.Security"/>

	<!-- Global functions, hooks, options and constants carry the plugin prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="vcap"/>
				<element value="VCAP"/>
			</property>
		</properties>
	</rule>
	<!--
		Deliberate exceptions (checked 16.11.2026, RELEASE_CHECKLIST.md → Plugin Check warnings):
		- Template variables are the documented template API for theme overrides ({theme}/voucher-captain/); renaming
		  them would break existing overrides.
		- Hooks of WooCommerce, WPML, Aelia and WP Pass Captain are fired on purpose for compatibility; own hooks all
		  start with vcap_.
		- DONOTCACHEPAGE is the constant page caches read; it cannot carry a prefix.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>templates/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>templates/emails/*</exclude-pattern>
		<exclude-pattern>src/Emails/*</exclude-pattern>
		<exclude-pattern>src/CartBlocks.php</exclude-pattern>
		<exclude-pattern>src/PaymentVouchers.php</exclude-pattern>
		<exclude-pattern>src/Compat/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.DynamicHooknameFound">
		<exclude-pattern>src/Compat/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>src/Shortcodes.php</exclude-pattern>
	</rule>
	<!--
		Callbacks of WordPress and WooCommerce hooks receive every argument of the hook, also the ones after the last
		one they use; and parameter names of public methods ($class, $default, $list …) are part of the API for named
		arguments – renaming them would break callers.
	-->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>
	<!-- Capabilities registered by WooCommerce and by this plugin (Install::add_caps / cashier role). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_shop_orders"/>
				<element value="edit_shop_coupons"/>
				<element value="publish_shop_coupons"/>
				<element value="edit_products"/>
				<element value="edit_product"/>
				<element value="view_woocommerce_reports"/>
				<element value="vcap_manage_vouchers"/>
				<element value="vcap_scan_tickets"/>
				<element value="vcap_increase_balance"/>
			</property>
		</properties>
	</rule>
</ruleset>

#: src/Attention.php:96 src/Compat/MultiCurrency.php:290 src/Diagnostics.php:23
msgid "Voucher Captain"
msgstr "Voucher Captain"

#. Plugin URI of the plugin
#: voucher-captain.php
msgid "https://github.com/hastla007/wp-couponmaster"
msgstr "https://github.com/hastla007/wp-couponmaster"

#. Description of the plugin
#: voucher-captain.php
msgid ""
"Sell personalised PDF vouchers, gift cards and store credit with "
"WooCommerce: visual PDF designer, recipient fields, scheduled delivery, "
"balance-tracked gift cards, code import and redemption in the shop, by API "
"or in WP Pass Captain."
msgstr ""
"Verkaufen Sie personalisierte PDF-Gutscheine, Geschenkkarten und "
"Kundenguthaben mit WooCommerce: visueller PDF-Designer, Empfängerfelder, "
"zeitgesteuerter Versand, Geschenkkarten mit Restwert, Code-Import und "
"Einlösung im Shop, per API oder in WP Pass Captain."

#. Author of the plugin
#: voucher-captain.php
msgid "CouponMaster"
msgstr "CouponMaster"

#: src/API/V1/RedemptionService.php:81 src/API/V1/RedemptionService.php:132
msgid "Too many invalid voucher codes. Please try again later."
msgstr ""
"Zu viele ungültige Gutscheincodes. Bitte versuchen Sie es später erneut."

#: src/API/V1/RedemptionService.php:86 src/API/V1/RedemptionService.php:144
#: src/Compat/PassCaptain/Exchange.php:37
msgid "This voucher code is not valid."
msgstr "Dieser Gutscheincode ist ungültig."

#: src/API/V1/RedemptionService.php:121
msgid ""
"A redemption key of 8–64 characters (letters, digits, . _ : -) is required."
msgstr ""
"Ein Einlöseschlüssel mit 8–64 Zeichen (Buchstaben, Ziffern, . _ : -) ist "
"erforderlich."

#: src/API/V1/RedemptionService.php:124

msgstr "Ein Hinweis im Dashboard und in den Gutschein-Ansichten warnt, sobald der Stapel nur noch so viele freie Codes oder weniger hat."

#: src/ProductSettings.php:507
msgid "Code prefix"
msgstr "Code-Präfix"

#: src/ProductSettings.php:507
msgid "Code suffix"
msgstr "Code-Suffix"

#: src/ProductSettings.php:513 src/ProductSettings.php:524
msgid "Global setting"
msgstr "Globale Einstellung"

#: src/ProductSettings.php:533

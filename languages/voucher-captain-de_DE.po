msgstr "Mindestbestellwert"

#: src/ProductSettings.php:457
msgid "Maximum spend"
msgstr "Höchstbestellwert"

#: src/ProductSettings.php:462
msgid "Valid for products"
msgstr "Gültig für Produkte"

#: src/ProductSettings.php:464
msgid "Valid for categories"
msgstr "Gültig für Kategorien"

#: src/ProductSettings.php:471 src/Settings.php:232

msgstr "Diese Einlösung wurde bereits abgeschlossen."

#: src/API/V1/RedemptionService.php:655 src/API/V1/RedemptionService.php:677 src/API/V1/RedemptionService.php:691
msgid "This reservation has expired or was cancelled. Please redeem the voucher again."
msgstr "Diese Reservierung ist abgelaufen oder wurde storniert. Bitte löse den Gutschein erneut ein."

#: src/API/V1/RedemptionService.php:696 src/API/V1/RedemptionService.php:799 src/Coupons/CartCoupons.php:69 src/Downloads.php:646
msgid "This voucher has been cancelled."
msgstr "Dieser Gutschein wurde storniert."

#: src/API/V1/RedemptionService.php:713
msgid "expired"
msgstr "abgelaufen"

#: src/API/V1/RedemptionService.php:786 src/Tickets.php:500
msgid "Store credit can only be used in the shop."
msgstr "Kundenguthaben kann nur im Shop verwendet werden."

#: src/API/V1/RedemptionService.php:789 src/Tickets.php:1066
msgid "Tickets are checked in at the entrance and cannot be redeemed here."
msgstr "Tickets werden am Einlass eingecheckt und können hier nicht eingelöst werden."

#: src/API/V1/RedemptionService.php:792 src/API/V1/RedemptionService.php:795
msgid "This voucher can only be used in the shop."
msgstr "Dieser Gutschein kann nur im Shop verwendet werden."

#: src/API/V1/RedemptionService.php:801 src/Coupons/CartCoupons.php:364
msgid "This voucher is not active yet."
msgstr "Dieser Gutschein ist noch nicht aktiv."

#: src/API/V1/RedemptionService.php:803 src/API/V1/RedemptionService.php:809 src/Compat/PassCaptain/Exchange.php:125 src/Coupons/CartCoupons.php:76
msgid "This voucher is currently being redeemed. Please try again in a few minutes."
msgstr "Dieser Gutschein wird gerade eingelöst. Bitte versuche es in einigen Minuten erneut."

#: src/API/V1/RedemptionService.php:805 src/API/V1/RedemptionService.php:816
msgid "This voucher has already been redeemed."
msgstr "Dieser Gutschein wurde bereits eingelöst."

#: src/API/V1/RedemptionService.php:812 src/Coupons/CartCoupons.php:374
msgid "This voucher has expired."
msgstr "Dieser Gutschein ist abgelaufen."

#: src/API/V1/RedemptionService.php:819
msgid "The remaining voucher balance is not sufficient."
msgstr "Der verbleibende Restwert des Gutscheins reicht nicht aus."

#: src/API/V1/RedemptionService.php:828
msgid "This voucher cannot be redeemed right now. Please contact the shop."
msgstr "Dieser Gutschein kann gerade nicht eingelöst werden. Bitte wende dich an den Shop."

#: src/API/V1/RedemptionService.php:842
msgid "This voucher is not valid for your account."
msgstr "Dieser Gutschein ist für dein Konto nicht gültig."

#: src/API/V1/RedemptionService.php:865
msgid "This voucher cannot be used for this purpose."
msgstr "Dieser Gutschein kann hierfür nicht verwendet werden."

#: src/API/V1/RedemptionService.php:877
msgid "The selected offer is currently not available."
msgstr "Das gewählte Angebot ist derzeit nicht verfügbar."

#: src/API/V1/RedemptionService.php:966
msgid "This redemption belongs to another user."
msgstr "Diese Einlösung gehört einem anderen Nutzer."

#: src/API/V1/RedemptionService.php:1057
msgid "The voucher could not be redeemed right now. Please try again."
msgstr "Der Gutschein konnte gerade nicht eingelöst werden. Bitte versuche es erneut."

#: src/API/V1/RestController.php:170
msgid "Please log in to redeem a voucher."
msgstr "Bitte melde dich an, um einen Gutschein einzulösen."

#: src/API/V1/RestController.php:235
msgid "This redemption target is managed by an integration."
msgstr "Dieses Einlöseziel wird von einer Integration verwaltet."

#: src/API/V1/RestController.php:250
msgid "Vouchers cannot be redeemed for this target here."
msgstr "Gutscheine können für dieses Ziel hier nicht eingelöst werden."

#: src/API/V1/RestController.php:401
msgid "This redemption key is reserved."
msgstr "Dieser Einlöse-Schlüssel ist reserviert."

#: src/API/V1/RestController.php:409
msgid "A redemption key with a prefix (\"system:…\") must use the prefix of its target."
msgstr "Ein Einlöseschlüssel mit Präfix („system:…“) muss das Präfix seines Ziels verwenden."

#: src/API/V1/RestController.php:492
msgid "Only the shop can give back a completed redemption. Please contact the shop."
msgstr "Eine abgeschlossene Einlösung kann nur der Shop zurückbuchen. Bitte wende dich an den Shop."

#: src/API/V1/VoucherService.php:95
msgid "The voucher system returned an invalid response."
msgstr "Das Gutscheinsystem hat eine ungültige Antwort geliefert."

#: src/API/V1/VoucherService.php:236
msgid "This event name cannot be written to the voucher history."
msgstr "Dieser Ereignisname kann nicht in den Gutscheinverlauf geschrieben werden."

#: src/API/V1/WooCommerceRedemptionProvider.php:76
msgid "A saved order and a positive amount are required."
msgstr "Eine gespeicherte Bestellung und ein positiver Betrag sind erforderlich."

#: src/API/V1/WooCommerceRedemptionProvider.php:79
msgid "This operation requires a stored-balance voucher."
msgstr "Dieser Vorgang erfordert einen Gutschein mit Restwert."

#: src/API/V1/WooCommerceRedemptionProvider.php:81
msgid "Reserved by an integration"
msgstr "Durch eine Integration reserviert"

#: src/API/V1/WooCommerceRedemptionProvider.php:83
msgid "Voucher balance is unavailable or has changed."
msgstr "Der Restwert des Gutscheins ist nicht verfügbar oder hat sich geändert."

#: src/API/V1/WooCommerceRedemptionProvider.php:120
msgid "No matching voucher reservation could be committed."
msgstr "Es konnte keine passende Gutschein-Reservierung verbucht werden."

#: src/API/V1/WooCommerceRedemptionProvider.php:156
msgid "Released by an integration"
msgstr "Durch eine Integration freigegeben"

#: src/API/V1/WooCommerceRedemptionProvider.php:157
msgid "No matching voucher reservation could be released."
msgstr "Es konnte keine passende Gutschein-Reservierung freigegeben werden."

#: src/AccountingExport.php:102
msgid "Debit account"
msgstr "Soll-Konto"

#: src/AccountingExport.php:102
msgid "Credit account"
msgstr "Haben-Konto"

#: src/AccountingExport.php:147
msgid "Accounting export"
msgstr "Buchhaltungsexport"

#: src/AccountingExport.php:149
msgid "Applies to the redemption journal (Vouchers → Reports → Redemption journal → Export CSV) and every other CSV export. Accounts and columns are a suggestion: agree them with your tax adviser for your country."
msgstr "Gilt für das Einlösejournal (Gutscheine → Auswertung → Einlösejournal → CSV exportieren) und jeden anderen CSV-Export. Konten und Spalten sind ein Vorschlag: Stimme sie mit deiner Steuerberatung für dein Land ab."

#: src/AccountingExport.php:154
msgid "Voucher liability account"
msgstr "Verbindlichkeitskonto für Gutscheine"

#: src/AccountingExport.php:157
msgid "Account for the value of sold vouchers still owed to customers (e.g. \"other liabilities\")."
msgstr "Konto für den Wert verkaufter Gutscheine, der der Kundschaft noch geschuldet wird (z. B. „sonstige Verbindlichkeiten“)."

#: src/AccountingExport.php:163
msgid "Clearing account"
msgstr "Verrechnungskonto"

#: src/AccountingExport.php:166
msgid "Counter account of voucher sales and redemptions (e.g. a clearing account for shop payments)."
msgstr "Gegenkonto für Gutscheinverkäufe und -einlösungen (z. B. ein Verrechnungskonto für Shop-Zahlungen)."

#: src/AccountingExport.php:172
msgid "Income account for forfeited value"
msgstr "Erlöskonto für verfallenen Wert"

#: src/AccountingExport.php:175
msgid "Counter account of value that is no longer owed: expired vouchers, forfeited remaining value, rounding rests."
msgstr "Gegenkonto für nicht mehr geschuldeten Wert: abgelaufene Gutscheine, verfallener Restwert, Rundungsreste."

#: src/AccountingExport.php:181
msgid "Accounts in the journal CSV"
msgstr "Konten in der Journal-CSV"

#: src/AccountingExport.php:183
msgid "Add the columns \"Debit account\" and \"Credit account\" to the journal CSV (from the three accounts above; empty for promotions). Off: the CSV keeps its columns."
msgstr "Die Spalten „Soll-Konto“ und „Haben-Konto“ an die Journal-CSV anfügen (aus den drei Konten oben; leer bei Aktionen). Aus: Die CSV behält ihre Spalten."

#: src/AccountingExport.php:189
msgid "Start of the financial year (MMDD)"
msgstr "Beginn des Wirtschaftsjahres (MMTT)"

#: src/AccountingExport.php:192
msgid "Month and day the financial year starts, e.g. 0101 for 1 January or 0701 for 1 July. The DATEV export assigns each booking to its financial year; agree it with your tax adviser."
msgstr "Monat und Tag des Beginns des Wirtschaftsjahres, z. B. 0101 für 1. Januar oder 0701 für 1. Juli. Der DATEV-Export ordnet jede Buchung ihrem Wirtschaftsjahr zu; stimme den Wert mit deiner Steuerberatung ab."

#: src/AccountingExport.php:198
msgid "CSV field separator"
msgstr "CSV-Trennzeichen"

#: src/AccountingExport.php:201 src/AccountingExport.php:215
msgid "Automatic (by your language)"
msgstr "Automatisch (nach deiner Sprache)"

#: src/AccountingExport.php:202
msgid "Semicolon (;)"
msgstr "Semikolon (;)"

#: src/AccountingExport.php:203
msgid "Comma (,)"
msgstr "Komma (,)"

#: src/AccountingExport.php:204
msgid "Tab"
msgstr "Tabulator"

#: src/AccountingExport.php:206
msgid "Automatic: a semicolon for languages with a decimal comma (e.g. German), else a comma – what spreadsheets there open in columns."
msgstr "Automatisch: ein Semikolon für Sprachen mit Dezimalkomma (z. B. Deutsch), sonst ein Komma – so öffnen Tabellenprogramme dort die Datei in Spalten."

#: src/AccountingExport.php:212
msgid "CSV decimal separator"
msgstr "CSV-Dezimaltrennzeichen"

#: src/AccountingExport.php:216
msgid "Comma (12,50)"

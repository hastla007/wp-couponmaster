msgstr "Personalisierung & Zustellung"

#: src/ProductSettings.php:535
msgid "Product page fields"
msgstr "Felder auf der Produktseite"

#: src/ProductSettings.php:560
msgid "Additional fields can be added under Vouchers → Field groups."
msgstr "Weitere Felder können unter Gutscheine → Feldgruppen hinzugefügt werden."

#: src/ProductSettings.php:564
msgid "Message max. characters"
msgstr "Max. Zeichen der Nachricht"

#: src/ProductSettings.php:573

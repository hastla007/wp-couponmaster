msgstr "Nachricht max. Zeilen"

#: src/ProductSettings.php:577
msgid "Empty or 0: no limit. Messages that would not fit the voucher are refused in any case."
msgstr "Leer oder 0: keine Grenze. Nachrichten, die nicht auf den Gutschein passen, werden in jedem Fall abgelehnt."

#: src/ProductSettings.php:592
msgid "Delay (days)"
msgstr "Verzögerung (Tage)"

#: src/ProductSettings.php:611
msgid "Send voucher to"
msgstr "Gutschein senden an"

#: src/ProductSettings.php:614

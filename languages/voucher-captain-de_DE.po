#: src/Attention.php:96 src/Compat/MultiCurrency.php:259 src/Diagnostics.php:23
msgid "Voucher Captain"
msgstr "Voucher Captain"

#. Plugin URI of the plugin
#: voucher-captain.php
msgid "https://github.com/hastla007/wp-couponmaster"
msgstr "https://github.com/hastla007/wp-couponmaster"

#. Description of the plugin
#: voucher-captain.php
msgid ""
"Sell personalised PDF vouchers, gift cards and store credit with "
"WooCommerce: visual PDF designer, recipient fields, scheduled delivery, "
"balance-tracked gift cards, code import and redemption in the shop, by API "
"or in WP Pass Captain."
msgstr ""
"Verkaufen Sie personalisierte PDF-Gutscheine, Geschenkkarten und "
"Kundenguthaben mit WooCommerce: visueller PDF-Designer, Empfängerfelder, "
"zeitgesteuerter Versand, Geschenkkarten mit Restwert, Code-Import und "
"Einlösung im Shop, per API oder in WP Pass Captain."

#. Author of the plugin
#: voucher-captain.php
msgid "CouponMaster"
msgstr "CouponMaster"

#: src/API/V1/RedemptionService.php:81 src/API/V1/RedemptionService.php:132

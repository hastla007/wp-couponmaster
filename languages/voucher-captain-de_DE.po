#: src/API/V1/RedemptionService.php:128
#, php-format
msgid "This voucher is kept in %1$s and cannot be redeemed in %2$s."
msgstr "Dieser Gutschein lautet auf %1$s und kann nicht in %2$s eingelöst werden."

#: src/API/V1/RedemptionService.php:154
msgid "A redemption key of 8–64 characters (letters, digits, . _ : -) is required."
msgstr "Ein Einlöseschlüssel mit 8–64 Zeichen (Buchstaben, Ziffern, . _ : -) ist erforderlich."

#: src/API/V1/RedemptionService.php:157
msgid "A redemption target is required."
msgstr "Ein Einlöseziel ist erforderlich."

#. translators: 1: maximum size in KB, 2: maximum nesting depth
#: src/API/V1/RedemptionService.php:161
#, php-format
msgid "The redemption metadata is too large (at most %1$d KB and %2$d levels)."
msgstr "Die Metadaten der Einlösung sind zu groß (höchstens %1$d KB und %2$d Ebenen)."

#: src/API/V1/RedemptionService.php:174 src/API/V1/RedemptionService.php:188 src/API/V1/RedemptionService.php:260
msgid "This redemption key was already used for another request."
msgstr "Dieser Einlöseschlüssel wurde bereits für eine andere Anfrage verwendet."

#: src/API/V1/RedemptionService.php:191
msgid "Please specify the amount to redeem from this gift card."
msgstr "Bitte gib an, welcher Betrag von dieser Geschenkkarte eingelöst werden soll."

#: src/API/V1/RedemptionService.php:195
msgid "Voucher redemption is temporarily unavailable."
msgstr "Die Gutscheineinlösung ist vorübergehend nicht verfügbar."

#. translators: 1: redemption key, 2: target
#: src/API/V1/RedemptionService.php:266 src/API/V1/RedemptionService.php:685
#, php-format
msgid "Redemption %1$s for %2$s"
msgstr "Einlösung %1$s für %2$s"

#: src/API/V1/RedemptionService.php:311
msgid "This voucher reservation was already released. Please redeem the voucher again."
msgstr "Diese Gutscheinreservierung wurde bereits freigegeben. Bitte löse den Gutschein erneut ein."

#: src/API/V1/RedemptionService.php:415 src/API/V1/RedemptionService.php:434
msgid "A redemption key, a refund key and a positive amount are required."
msgstr "Einlöse-Schlüssel, Erstattungs-Schlüssel und ein positiver Betrag sind erforderlich."

#: src/API/V1/RedemptionService.php:419 src/API/V1/RedemptionService.php:595 src/API/V1/RedemptionService.php:643 src/API/V1/RedemptionService.php:962 src/API/V1/RestController.php:355
msgid "No redemption exists for this key."
msgstr "Für diesen Schlüssel existiert keine Einlösung."

#: src/API/V1/RedemptionService.php:437
msgid "Only completed redemptions can be refunded."
msgstr "Nur abgeschlossene Einlösungen können erstattet werden."

#: src/API/V1/RedemptionService.php:475
msgid "This redemption has already been refunded completely."
msgstr "Diese Einlösung wurde bereits vollständig erstattet."

#. translators: 1: refund key, 2: redemption key
#: src/API/V1/RedemptionService.php:501
#, php-format
msgid "Refund %1$s of redemption %2$s"
msgstr "Erstattung %1$s der Einlösung %2$s"

#: src/API/V1/RedemptionService.php:639
msgid "Invalid redemption key."
msgstr "Ungültiger Einlöseschlüssel."

#: src/API/V1/RedemptionService.php:654

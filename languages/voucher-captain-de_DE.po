#: src/Coupons/CartCoupons.php:76
msgid ""
"This voucher is currently being redeemed. Please try again in a few minutes."
msgstr ""
"Dieser Gutschein wird gerade eingelöst. Bitte versuchen Sie es in einigen "
"Minuten erneut."

#: src/API/V1/RedemptionService.php:752 src/API/V1/RedemptionService.php:763
msgid "This voucher has already been redeemed."
msgstr "Dieser Gutschein wurde bereits eingelöst."

#: src/API/V1/RedemptionService.php:759 src/Coupons/CartCoupons.php:82
msgid "This voucher has expired."
msgstr "Dieser Gutschein ist abgelaufen."

#: src/API/V1/RedemptionService.php:766
msgid "The remaining voucher balance is not sufficient."
msgstr "Der verbleibende Restwert des Gutscheins reicht nicht aus."

#: src/API/V1/RedemptionService.php:775
msgid "This voucher cannot be redeemed right now. Please contact the shop."
msgstr ""
"Dieser Gutschein kann gerade nicht eingelöst werden. Bitte wenden Sie sich "
"an den Shop."

#: src/API/V1/RedemptionService.php:789
msgid "This voucher is not valid for your account."
msgstr "Dieser Gutschein ist für Ihr Konto nicht gültig."

#: src/API/V1/RedemptionService.php:812
msgid "This voucher cannot be used for this purpose."
msgstr "Dieser Gutschein kann hierfür nicht verwendet werden."

#: src/API/V1/RedemptionService.php:824
msgid "The selected offer is currently not available."
msgstr "Das gewählte Angebot ist derzeit nicht verfügbar."

#: src/API/V1/RedemptionService.php:979
msgid "The voucher could not be redeemed right now. Please try again."
msgstr ""
"Der Gutschein konnte gerade nicht eingelöst werden. Bitte versuchen Sie es "
"erneut."

#: src/API/V1/RestController.php:152

msgid "A redemption key, a refund key and a positive amount are required."
msgstr ""
"Einlöse-Schlüssel, Erstattungs-Schlüssel und ein positiver Betrag sind "
"erforderlich."

#: src/API/V1/RedemptionService.php:378 src/API/V1/RedemptionService.php:548
#: src/API/V1/RedemptionService.php:596
msgid "No redemption exists for this key."
msgstr "Für diesen Schlüssel existiert keine Einlösung."

#: src/API/V1/RedemptionService.php:392 src/API/V1/RedemptionService.php:599
#: src/API/V1/RestController.php:291
msgid "This redemption belongs to another user."
msgstr "Diese Einlösung gehört einem anderen Nutzer."

#: src/API/V1/RedemptionService.php:395
msgid "Only completed redemptions can be refunded."
msgstr "Nur abgeschlossene Einlösungen können erstattet werden."

#: src/API/V1/RedemptionService.php:428
msgid "This redemption has already been refunded completely."
msgstr "Diese Einlösung wurde bereits vollständig erstattet."

#. translators: 1: refund key, 2: redemption key
#: src/API/V1/RedemptionService.php:454
#, php-format
msgid "Refund %1$s of redemption %2$s"
msgstr "Erstattung %1$s der Einlösung %2$s"

#: src/API/V1/RedemptionService.php:592

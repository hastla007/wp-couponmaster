# Strict static analysis of the public API v1 and the contracts (CI job quality, blocking).
parameters:
  level: 8
  paths:
    - src/API/V1
    - src/Contracts
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
  scanFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
